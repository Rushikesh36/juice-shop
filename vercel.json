{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "functions": {
        "**": {
          "includeFiles": "{config,data,i18n,views,ftp,encryptionkeys,uploads,frontend/dist,.well-known}/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
