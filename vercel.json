{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "index.ts",
      "functions": {
        "index.ts": {
          "includeFiles": "{swagger.yml,ctf.key,config/**,data/**,i18n/**,views/**,ftp/**,encryptionkeys/**,.well-known/**,infrastructure/**,frontend/dist/**,node_modules/sqlite3/**,node_modules/bindings/**,node_modules/file-uri-to-path/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
